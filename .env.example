# ==============================================================================
# TrustVault Environment Variables (Render.com and Local Development)
# ==============================================================================

# --- Application Configuration ---
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://trustvault.onrender.com
PORT=3000

# --- Server-Side Session Security ---
SESSION_SECRET=replace-with-a-64-char-random-cryptographic-secret

# --- Demo & Development Credentials (CHANGE BEFORE PRODUCTION) ---
DEMO_PASSWORD=TrustVault2024!

# --- PostgreSQL Database (Prisma ORM & Docker) ---
DATABASE_URL=postgresql://trustvault_user:trustvault_dev_password@localhost:5432/trustvault

# --- S3 / MinIO Compatible Storage (Optional, defaults to local private store) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=trustvault-documents
S3_ACCESS_KEY_ID=trustvault_minio_admin
S3_SECRET_ACCESS_KEY=trustvault_minio_dev_secret
S3_REGION=us-east-1

# --- Supabase Database & Cloud Storage (Optional) ---
# If omitted, TrustVault runs in standalone zero-dependency mode out-of-the-box.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Persistent Data Directory (for Standalone / Render Disk) ---
# DATA_DIR=/var/data
