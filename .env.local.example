# ==============================================================================
# TrustVault Environment Configuration
# ==============================================================================

# --- Application URL ---
# Local: http://localhost:3000
# Render.com: https://<your-service-name>.onrender.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Demo Accounts Password ---
# Used for pre-seeded accounts: admin@example.com, owner@example.com, viewer@example.com
DEMO_PASSWORD=TrustVault2024!

# --- Supabase Database & Storage (Optional: required for PostgreSQL + RLS mode) ---
# If omitted or left as mock, TrustVault automatically operates in self-contained zero-config mode!
# 1. Project URL from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# 2. Anon / Public Key (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# 3. Service Role Secret Key (Server-side ONLY, never sent to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Optional Persistent Data Directory (for standalone zero-config mode) ---
# DATA_DIR=/var/data
